# ==============================================================================
# AI-Studio Musical — TOUS les paramètres du projet
# Copy this file to .env (gitignored, never committed) and fill in your values:
#   cp .env.example .env
# Règle : une variable déjà définie dans l'environnement réel du shell prime sur `.env`.
# ==============================================================================

# --- Racine & chemins ---------------------------------------------------------
# AI_STUDIO_DIR=            # racine du dépôt ; vide = auto-détection (parent de scripts/)
# AI_STUDIO_SAMPLES_DIR=    # dossier des samples à indexer ; défaut : <racine>/samples
# PROJECT_SAMPLES_DIR=      # dossier de samples utilisateur d'un projet (résolu si pas de Samples/ local)
# ALLOW_SYNTH_FALLBACK=     # 1 = autorise le fallback silencieux gridline_native malgré le gate (déconseillé)
# AI_STUDIO_RESTART_MCP=1    # install.sh : tue les processus MCP orphelins + smoke test stdio des serveurs (0 pour désactiver)
# AI_STUDIO_WORKER=1         # v4.3 (D6) façade ai-studio-prod : chaque appel d'outil délègue à un worker subprocess
                              # éphémère (prod_worker.py, code disque à jour, 0 RESTART session agent) ; 0 = appel in-process
# AI_STUDIO_DB_PATH=        # base SQLite de l'index samples ; défaut : <racine>/mcp-servers/audio-index/samples.db
# GRIDLINE_EMPTY_TEMPLATE=  # template de projet vide Gridline (optionnel ; sinon détection auto)
# MIX_PROFILES_PATH=        # profils de mix ; défaut : <racine>/config/mix_profiles.json
# AI_STUDIO_CLAP_MODEL=laion/clap-htsat-unfused   # modèle CLAP (embeddings sémantiques)

# --- Clés API (SECRETS — .env reste local, ne jamais le committer) ------------
# Freesound API v2 (https://freesound.org/apiv2/apply) — fetch_samples_api.py & audio-index MCP
# FREESOUND_API_KEY=

# Lots of Sounds API (https://lotsofsounds.com - prefix los_...)
# Note: without key, public demo endpoint /api/v1/sounds/sample (6 CC0 samples) is used as fallback.
# LOTSOFSOUNDS_API_KEY=

# Backend d'écoute multimodal (listener_backend.py) ; vide = 100 % local (déterministe, 0 GPU)
# AI_STUDIO_AUDIO_LISTENER_URL=
# AI_STUDIO_AUDIO_LISTENER_MODEL=gemini-2.5-flash
# AI_STUDIO_AUDIO_LISTENER_KEY=

# --- Options d'installation (équivalents .env des flags de ./install.sh) ------
# AI_STUDIO_SKIP_PLUGINS=0    # --skip-plugins  (plugins audio tiers Surge/TDR/CHOW/LSP...)
# AI_STUDIO_SKIP_CLAP=0       # --skip-clap     (pas de préchargement CLAP)
# AI_STUDIO_SKIP_ZED=0        # --skip-zed
# AI_STUDIO_SKIP_STRUDEL=0    # --skip-strudel  (pas de npm install du pont Strudel)
# AI_STUDIO_ORGANIZE_SAMPLES=1  # install.sh : classe les samples de la racine de samples/ dans leurs
                                # sous-dossiers par catégorie (808/, kick/, ...) avant indexation ; 0 = désactivé
# AI_STUDIO_NO_SUDO=0         # --no-sudo
# AI_STUDIO_CHECK_ONLY=0      # --check-only
# AI_STUDIO_FORCE_RESCAN=0    # --force-rescan
# AI_STUDIO_GIT_PULL=1        # install.sh fait un `git pull --ff-only` en premier pour synchroniser
                              # le code (0 = désactivé) ; si le code change, redémarrer la session agent
