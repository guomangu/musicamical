// @meta 126 D:dorian edm_club V=0.2 form=I4-D4-V4-C8-O4 seed=303 ts=4/4
kit("house", {var: 1})
$chords: grid("Dm7 G7 Cmaj7 Fmaj7").slow(2).gain(0.8).in("drop,chorus")
$bass: bassline("<1 1 ~ 1>", {mode: "root", glide: 25}).slow(4).in("verse,drop,chorus,outro")
$lead: deg("0 ~ 3 ~ 5 ~ 4 ~ 7 ~ 5 ~ 3 ~", 4).slow(2).gain(0.6).sometimesBy(0.3, x => x.degradeBy(0.5)).only("drop,chorus")
