// @meta 88 D:minor lofi_chill V=0.0 form=I4-V8-P4-C8-V8-C8-O4 seed=8804
$kick: s("bd ~ [~ bd] ~").sometimesBy(0.25, x => x.degradeBy(0.5)).gain(0.75).in("verse,pre_chorus,chorus")
$snare: s("~ sd ~ sd").sometimesBy(0.2, x => x.degradeBy(0.4)).gain(0.65).in("verse,pre_chorus,chorus")
$hihat: s("hh*8").sometimesBy(0.3, x => x.degradeBy(0.5)).gain(0.45).in("pre_chorus,chorus")
$chords: grid("Dm7 Fmaj7 C6 Am7 Dm9 Fmaj7 Am7 C6").slow(2).gain(0.60)
$bass: bassline("<1 ~ 1 ~ 1 ~ 3 ~ 1 ~ 1 ~ 4 ~ 3 ~>", {mode: "root", glide: 35}).slow(4).gain(0.75).in("verse,pre_chorus,chorus,outro")
$lead: deg("3 6 4 ~ 4 7 6 4 ~ 3 4 6 4 ~ 3 4 ~", 4).slow(2).gain(0.60).in("verse,pre_chorus,chorus")
