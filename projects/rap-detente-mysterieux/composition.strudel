// @meta 96 C:minor trap_rap V=0.0 form=I4-V16-C8-B8-V16-C8-O8 seed=4219 ts=4/4
$kick: s("bd ~ ~ [~ bd] ~ bd ~ [~ bd]").sometimesBy(0.2, x => x.degradeBy(0.5)).muteIn("intro,bridge,outro")
$snare: s("~ ~ snare ~ ~ ~ snare ~").in("verse,chorus")
$hihat: s("hh*8 [hh*4 hh*8] hh*8 [hh*4 [hh hh hh hh]]").slow(4).sometimesBy(0.25, x => x.degradeBy(0.4)).gain(0.65).muteIn("intro")
$perc: s("~ ~ ~ rim ~ sh ~ [~ rim]").sometimesBy(0.25, x => x.degradeBy(0.5)).gain(0.55).in("verse,chorus,bridge,outro")
$chords: grid("Cm7 Abmaj7 Fm7 Gm7").slow(2).gain(0.62)
$pad: deg("0 ~ 0 ~ 2 ~ 2 ~ 3 ~ 3 ~ 4 ~ 4 ~", 4).slow(8).gain(0.42).in("intro,chorus,bridge,outro")
$bass: bassline("0 ~ ~ 0 ~ 0 ~ ~ 0 ~ ~ ~ 0 ~ 2 ~ 5 ~ ~ 5 ~ 5 ~ ~ 5 ~ ~ ~ 5 ~ 2 ~ 3 ~ ~ 3 ~ 3 ~ ~ 3 ~ ~ ~ 3 ~ 2 ~ 4 ~ ~ 4 ~ 4 ~ ~ 4 ~ ~ ~ 4 ~ 3 ~", {glide: 40}).slow(8).in("verse,chorus,outro")
$lead: deg("0 3 2 0 ~ 2 3 4 ~ 4 3 2 ~ 3 2 0 ~ 2 3 2 ~ 0 3 2 ~ 2 3 2 ~ 3 2 0 ~ 3 2 0 ~ 2 3 5 ~ 5 6 5 ~ 3 2 0 ~ 0 1 3 ~ 4 3 1 ~ 3 1 0 ~ 3 1 0", 4).slow(8).gain(0.68).in("intro,verse,chorus,bridge,outro")
